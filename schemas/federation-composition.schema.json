{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/federation-composition/v1",
  "title": "Bounded source-authorized graph composition",
  "description": "Request by default; result definition is a derived graph, not authority or an access grant. Semantic record, exact digest, source consistency and endpoint validation also apply at runtime.",
  "x-conflict": {
    "version": "1.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sources",
    "budget"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 1024
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSources",
        "maxNodes",
        "maxEdges",
        "maxBytes"
      ],
      "properties": {
        "maxSources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant",
        "realm",
        "revision"
      ],
      "properties": {
        "participant": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant",
        "realm",
        "address"
      ],
      "properties": {
        "participant": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant",
        "realm",
        "authority",
        "revision",
        "evaluatedAt",
        "recordSha256",
        "policySha256",
        "ontologySha256",
        "bindingsSha256",
        "publicationSha256"
      ],
      "properties": {
        "participant": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evaluatedAt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ontologySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bindingSha256",
            "snapshotSha256",
            "state",
            "recordRevision"
          ],
          "properties": {
            "kind": {
              "const": "sqlite-authority"
            },
            "bindingSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshotSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "state": {
              "const": "active"
            },
            "recordRevision": {
              "type": "string",
              "pattern": "^[1-9][0-9]*:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "record",
        "provenance"
      ],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "record": {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "record",
        "provenance",
        "source",
        "target"
      ],
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/coordinate"
        },
        "record": {
          "type": "object",
          "required": [
            "source",
            "target",
            "rel"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "rel": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source": {
          "$ref": "#/$defs/coordinate"
        },
        "target": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "sourceResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "status",
            "truncation",
            "snapshotSha256"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/source"
            },
            "status": {
              "const": "composed"
            },
            "truncation": {
              "type": "array",
              "items": {
                "enum": [
                  "maxBytes",
                  "maxNodes",
                  "maxEdges",
                  "maxSources",
                  "sourcePartial",
                  "endpointPartial"
                ]
              },
              "uniqueItems": true
            },
            "snapshotSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "status",
            "reason"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/source"
            },
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "unavailable",
                "offline",
                "revision-changed",
                "unsupported-contract",
                "unsupported-transport",
                "maxBytes",
                "invalid-response"
              ]
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "method",
        "federation",
        "authorization",
        "sources",
        "nodes",
        "edges",
        "truncation",
        "coverage"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "method": {
          "const": "authorized-graph-composition/v1"
        },
        "federation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal",
            "evaluatedAt"
          ],
          "properties": {
            "principal": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evaluatedAt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceResult"
          },
          "maxItems": 64
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 10000
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 20000
        },
        "truncation": {
          "type": "array",
          "items": {
            "enum": [
              "maxBytes",
              "maxNodes",
              "maxEdges",
              "maxSources",
              "sourcePartial",
              "endpointPartial"
            ]
          },
          "uniqueItems": true
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "not-assessed"
            }
          }
        }
      }
    }
  }
}
