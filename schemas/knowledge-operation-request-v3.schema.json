{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/knowledge-operation-request/v3",
  "title": "Authorized source and proposal discovery request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authority",
        "operation",
        "arguments"
      ],
      "properties": {
        "format": {
          "const": "knowledge-operation-request/v3"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "operation": {
          "const": "source.list"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limit",
            "cursor"
          ],
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cursor": {
              "$ref": "#/$defs/cursor"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authority",
        "operation",
        "arguments"
      ],
      "properties": {
        "format": {
          "const": "knowledge-operation-request/v3"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "operation": {
          "const": "proposal.list"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collections",
            "limit",
            "cursor"
          ],
          "properties": {
            "collections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cursor": {
              "$ref": "#/$defs/cursor"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authority",
        "operation",
        "arguments"
      ],
      "properties": {
        "format": {
          "const": "knowledge-operation-request/v3"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "operation": {
          "const": "collection.semantic-inspect"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection"
          ],
          "properties": {
            "collection": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "cursor": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basisSha256",
            "after"
          ],
          "properties": {
            "basisSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "after": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
