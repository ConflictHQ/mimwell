      ]
    },
    "read_record": {
      "legacyInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "A record id, e.g. 'decision:pick-alpha'."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "A document path, e.g. 'knowledge/docs/overview.md'."
          }
        }
      },
      "nativeInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
