{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis.schema.json",
  "title": "Durable Markdown synthesis and incremental update",
  "description": "Text is authored canon with retained original-source lineage. Generator baseline hashes detect human edits. This contract supplies no independent corroboration or authenticated review. Requests additionally use the existing bounded-context validator.",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "id",
        "text",
        "sections"
      ],
      "properties": {
        "format": {
          "const": "synthesis/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "sections": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9_.-]*$": {
              "$ref": "#/$defs/section"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "summary",
        "context",
        "extractionConfidence",
        "updates"
      ],
      "properties": {
        "format": {
          "const": "synthesis-update/v1"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object"
        },
        "extractionConfidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "baseGeneratedSha256",
              "text",
              "citations"
            ],
            "properties": {
              "section": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "baseGeneratedSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "record",
                    "attestation"
                  ],
                  "properties": {
                    "record": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "edge"
                          ],
                          "properties": {
                            "edge": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "participant",
                            "realm",
                            "address",
                            "revision"
                          ],
                          "properties": {
                            "participant": {
                              "type": "string",
                              "minLength": 1
                            },
                            "realm": {
                              "type": "string",
                              "minLength": 1
                            },
                            "address": {
                              "type": "string",
                              "minLength": 1
                            },
                            "revision": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    },
                    "attestation": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedSha256",
        "citations",
        "basis",
        "generation"
      ],
      "properties": {
        "generatedSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "contextSha256"
          ],
          "properties": {
            "request": {
              "type": "object"
            },
            "contextSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidateSha256",
            "extractionConfidence"
          ],
          "properties": {
            "candidateSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "extractionConfidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "attestation",
        "assertion",
        "assertionStatus",
        "representation",
        "representationSha256",
        "locator",
        "href",
        "observation",
        "stance",
        "reviewState",
        "extractionConfidence",
        "originalLineages",
        "sources",
        "dependencies"
      ],
      "properties": {
        "record": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edge"
              ],
              "properties": {
                "edge": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "participant",
                "realm",
                "address",
                "revision"
              ],
              "properties": {
                "participant": {
                  "type": "string",
                  "minLength": 1
                },
                "realm": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "attestation": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "assertionStatus": {
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "representationSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "const": "available"
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "mentions"
          ]
        },
        "reviewState": {
          "enum": [
            "unknown",
            "unreviewed",
            "reviewed",
            "disputed",
            "retracted"
          ]
        },
        "extractionConfidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "originalLineages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "currentRevision",
        "lineage",
        "path",
        "sha256",
        "modality",
        "capturedAt",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "currentRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "lineage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "modality": {
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "code",
            "document",
            "structured"
          ]
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "quote"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startLine",
            "endLine",
            "commit"
          ],
          "properties": {
            "kind": {
              "const": "code"
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "region"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "region": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "region"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startMs",
            "endMs"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "startMs": {
              "type": "number",
              "minimum": 0
            },
            "endMs": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "beforeSha256",
        "candidateSha256",
        "authorization",
        "after",
        "changed",
        "conflicts",
        "status",
        "lineage"
      ],
      "properties": {
        "format": {
          "const": "synthesis-plan/v1"
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal",
            "evaluatedAt"
          ],
          "properties": {
            "principal": {
              "type": "string",
              "minLength": 1
            },
            "evaluatedAt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "after": {
          "$ref": "#/$defs/document"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "reason"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "generator-baseline-changed",
                  "human-edit-preserved"
                ]
              }
            }
          }
        },
        "status": {
          "const": "proposed"
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "humanEdited",
              "sources"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "humanEdited": {
                "type": "boolean"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reference",
                    "state",
                    "currentObservation"
                  ],
                  "properties": {
                    "reference": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record",
                        "attestation"
                      ],
                      "properties": {
                        "record": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "edge"
                              ],
                              "properties": {
                                "edge": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "participant",
                                "realm",
                                "address",
                                "revision"
                              ],
                              "properties": {
                                "participant": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "realm": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "address": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "revision": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "attestation": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "state": {
                      "enum": [
                        "unchanged",
                        "changed",
                        "unavailable"
                      ]
                    },
                    "currentObservation": {
                      "enum": [
                        "available",
                        "stale",
                        "missing",
                        "unknown",
                        null
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "proposal": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "object"
        }
      }
    }
  }
}
