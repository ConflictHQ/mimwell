{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portal-templates.schema.json",
  "title": "Portal presentation templates",
  "description": "Validates optional purpose homes while allowing existing instance-owned presentation extensions. A home changes presentation only.",
  "type": "object",
  "required": [
    "templates"
  ],
  "properties": {
    "format": {
      "const": "portal-templates/v1"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "home": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layout": {
                "enum": [
                  "company",
                  "project",
                  "topic",
                  "personal"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "primary": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^/(?!/)[^?#]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "url",
                    "label",
                    "description"
                  ]
                }
              },
              "sections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^/(?!/)[^?#]*$"
                    },
                    "kinds": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "empty": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "description",
                    "url",
                    "kinds",
                    "empty"
                  ]
                }
              },
              "prompts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "layout",
              "title",
              "description",
              "primary",
              "sections",
              "prompts"
            ]
          }
        }
      }
    }
  }
}
