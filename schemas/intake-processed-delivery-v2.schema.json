{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake-processed-delivery/v2",
  "title": "Reviewed processing delivery including explicit model timing uncertainty",
  "oneOf": [
    {
      "$ref": "#/$defs/origin"
    },
    {
      "$ref": "#/$defs/representation"
    }
  ],
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "history",
        "basis",
        "item",
        "labels",
        "destination",
        "generated",
        "representation"
      ],
      "properties": {
        "format": {
          "const": "intake-processed-record/v1"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "sha256",
            "event"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "event": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "basis": {
          "$ref": "conflict:schema/intake/v1#/$defs/basis"
        },
        "item": {
          "$ref": "conflict:schema/intake/v1#/$defs/item"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "target",
            "status",
            "completionSha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target": {
              "$ref": "conflict:schema/intake/v1#/$defs/target"
            },
            "status": {
              "const": "proposed"
            },
            "completionSha256": {
              "type": "null"
            }
          }
        },
        "generated": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "text"
          ],
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "text": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "representation": {
          "$ref": "#/$defs/representation"
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "receipt",
        "sourceResource",
        "scope"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceResource": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "conflict:schema/intake-extraction/v1"
            },
            {
              "$ref": "conflict:schema/intake-transcription/v1"
            },
            {
              "$ref": "conflict:schema/intake-transcription/v2"
            }
          ]
        }
      }
    }
  }
}
