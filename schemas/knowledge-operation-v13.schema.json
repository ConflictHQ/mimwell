{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimwell:schema/knowledge-operation/v13",
  "title": "Bounded current native collection page or opted-in discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "authority",
    "operation",
    "contract",
    "authorization",
    "state",
    "native",
    "nativeSha256",
    "nativeWire",
    "requestWire",
    "requestSha256"
  ],
  "properties": {
    "format": {
      "const": "knowledge-operation/v13"
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "operation": {
      "enum": [
        "authority.inspect",
        "collection.browse"
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "evaluatedAt",
        "revalidatedAt"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revalidatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "state": {
      "const": "completed"
    },
    "native": {},
    "nativeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nativeWire": {
      "type": "string",
      "description": "Exact UTF-8 canonical native result; SHA-256 equals nativeSha256 without numeric reserialization."
    },
    "requestWire": {
      "type": "string"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authority",
        "principal",
        "binding",
        "operations",
        "authorization",
        "nativePolicy",
        "executionAuthorized",
        "recordPatchVersions",
        "sourceSelectionSha256",
        "collectionBrowseVersions"
      ],
      "properties": {
        "format": {
          "const": "authoring-capabilities/v1"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "authorization": {
          "const": "host-registration-only"
        },
        "nativePolicy": {
          "const": "required-per-operation"
        },
        "executionAuthorized": {
          "const": false
        },
        "recordPatchVersions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "v1",
              "v9",
              "v12"
            ]
          }
        },
        "sourceSelectionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "collectionBrowseVersions": {
          "type": "array",
          "const": [
            "v13"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "collection.browse"
          }
        }
      },
      "then": {
        "properties": {
          "native": {
            "$ref": "native-collection-page-v1.schema.json"
          }
        }
      }
    }
  ]
}
