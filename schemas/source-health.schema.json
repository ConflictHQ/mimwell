{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/source-health/v1",
  "title": "Bounded registered local source observation",
  "description": "Observed source readability and registered content-revision comparison; no upstream-age, ongoing availability, writer or access grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source",
    "registrationSha256",
    "scope",
    "probe",
    "observedAt",
    "availability",
    "reason",
    "sourceSha256",
    "sourceBytes",
    "filesystemObservationSha256",
    "expectedSourceSha256",
    "revisionState",
    "upstreamFreshness",
    "maxSourceBytes",
    "executionAuthorized",
    "authorization",
    "basisSha256"
  ],
  "properties": {
    "format": {
      "const": "source-health/v1"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "registrationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "const": "one-registered-local-source"
    },
    "probe": {
      "const": "bounded-stable-regular-file-read"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "reason": {
      "enum": [
        "bounded-source-read-completed",
        "source-unavailable-within-probe-bound"
      ]
    },
    "sourceSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        {
          "type": "null"
        }
      ]
    },
    "filesystemObservationSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedSourceSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revisionState": {
      "enum": [
        "unknown",
        "unasserted",
        "matched",
        "mismatched"
      ]
    },
    "upstreamFreshness": {
      "const": "unknown"
    },
    "maxSourceBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "executionAuthorized": {
      "const": false
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "evaluatedAt",
        "scopes",
        "policy"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256",
            "ontologySha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ontologySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "basisSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "bounded-source-read-completed"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "filesystemObservationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "revisionState": {
            "enum": [
              "unasserted",
              "matched",
              "mismatched"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "const": "source-unavailable-within-probe-bound"
          },
          "sourceSha256": {
            "type": "null"
          },
          "filesystemObservationSha256": {
            "type": "null"
          },
          "sourceBytes": {
            "type": "null"
          },
          "revisionState": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}
