{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake-extraction/v1",
  "title": "Source-bound local document extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "captureSha256",
    "item",
    "profile",
    "profileSha256",
    "principal",
    "evaluatedAt",
    "policySha256",
    "bindingsSha256",
    "scopes",
    "coverage",
    "segments",
    "gaps",
    "usage"
  ],
  "properties": {
    "format": {
      "const": "intake-extraction/v1"
    },
    "captureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "item": {
      "$ref": "conflict:schema/intake/v1#/$defs/item"
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "maxSourceBytes",
            "maxTextBytes",
            "maxPages",
            "timeoutSeconds"
          ],
          "properties": {
            "adapter": {
              "const": "utf8-text/v1"
            },
            "maxSourceBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxTextBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "maxSourceBytes",
            "maxTextBytes",
            "maxPages",
            "timeoutSeconds",
            "binary",
            "binarySha256",
            "libraryDirectories"
          ],
          "properties": {
            "adapter": {
              "const": "poppler-text/v1"
            },
            "maxSourceBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxTextBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            },
            "maxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "binary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "binarySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "libraryDirectories": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      ]
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "coverage": {
      "enum": [
        "utf8-source",
        "pdf-text-layer"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "text",
          "gaps"
        ],
        "properties": {
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "properties": {
                  "kind": {
                    "const": "bytes"
                  },
                  "start": {
                    "const": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "number"
                ],
                "properties": {
                  "kind": {
                    "const": "page"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2097152
          },
          "gaps": {
            "enum": [
              [],
              [
                "no-text"
              ]
            ]
          }
        }
      }
    },
    "gaps": {
      "enum": [
        [],
        [
          "no-text"
        ]
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBytes",
        "outputBytes",
        "modelCalls",
        "processCalls",
        "elapsedMs"
      ],
      "properties": {
        "sourceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "modelCalls": {
          "const": 0
        },
        "processCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
