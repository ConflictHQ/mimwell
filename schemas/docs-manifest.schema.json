{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/docs-manifest/v1",
  "title": "Categorized document library (app/docs-manifest.json)",
  "description": "Markdown organized into a curated hierarchy of sections -> groups -> docs, each with id/label/description/count, rendered by /library/. Generated by scripts/gen-docs-manifest.py; section/group placement is curated and preserved across regens (central config #17 seeds the categories).",
  "x-conflict": { "version": "1", "editable": false, "source": "app/docs-manifest.json" },
  "type": "object",
  "required": ["sections"],
  "properties": {
    "$comment": { "type": "string" },
    "generated": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "doc": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "updated": { "type": "string" },
        "reading_time": { "type": "integer", "minimum": 1, "description": "Estimated minutes to read (word count / 200wpm), recomputed on every regen." }
      }
    },
    "group": {
      "type": "object",
      "required": ["label", "docs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/doc" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "label", "count"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "default": { "type": "boolean", "description": "Marks the catch-all bucket newly-discovered docs append to." },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/doc" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      }
    }
  }
}
