{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake-transcription/v2",
  "title": "Local transcription with reported timing and bounded source windows",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "item",
    "captureSha256",
    "profile",
    "profileSha256",
    "dependencies",
    "principal",
    "evaluatedAt",
    "scopes",
    "policySha256",
    "bindingsSha256",
    "audio",
    "language",
    "coverage",
    "requiresReview",
    "segments",
    "gaps",
    "usage",
    "timingSemantics"
  ],
  "properties": {
    "format": {
      "const": "intake-transcription/v2"
    },
    "item": {
      "$ref": "conflict:schema/intake/v1#/$defs/item"
    },
    "captureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceResource",
        "modelResource",
        "scope",
        "modelIdentity"
      ],
      "properties": {
        "sourceResource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelResource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "origin",
        "sampleRate",
        "channels",
        "sampleFrames",
        "sha256"
      ],
      "properties": {
        "selector": {
          "const": "0:a:0"
        },
        "origin": {
          "const": "decoded-audio-start"
        },
        "sampleRate": {
          "const": 16000
        },
        "channels": {
          "const": 1
        },
        "sampleFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9600000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "coverage": {
      "const": "selected-audio-transcript"
    },
    "requiresReview": {
      "const": true
    },
    "segments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reportedLocator",
          "sourceWindow",
          "timingStatus",
          "text"
        ],
        "properties": {
          "reportedLocator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "kind": {
                "const": "audio-ms"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 630000
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 630000
              }
            }
          },
          "sourceWindow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "kind": {
                "const": "audio-frames"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9600000
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9600000
              }
            }
          },
          "timingStatus": {
            "enum": [
              "within-audio-estimate",
              "extends-past-audio"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1048576
          }
        }
      }
    },
    "gaps": {
      "enum": [
        [],
        [
          "no-transcript"
        ]
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBytes",
        "normalizedBytes",
        "textBytes",
        "modelExecutions",
        "processCalls",
        "decode",
        "transcribe"
      ],
      "properties": {
        "sourceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "normalizedBytes": {
          "type": "integer",
          "minimum": 46,
          "maximum": 19200044
        },
        "textBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "modelExecutions": {
          "const": 1
        },
        "processCalls": {
          "const": 2
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelExecutions",
            "processCalls",
            "elapsedMs"
          ],
          "properties": {
            "modelExecutions": {
              "const": 0
            },
            "processCalls": {
              "const": 1
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "transcribe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelExecutions",
            "processCalls",
            "elapsedMs"
          ],
          "properties": {
            "modelExecutions": {
              "const": 1
            },
            "processCalls": {
              "const": 1
            },
            "elapsedMs": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "timingSemantics": {
      "const": "model-estimate-with-source-window-not-alignment"
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "ffmpeg",
        "whisper",
        "model",
        "language",
        "threads",
        "maxSourceBytes",
        "maxAudioSeconds",
        "maxTextBytes",
        "maxSegments",
        "decodeTimeoutSeconds",
        "modelTimeoutSeconds",
        "maxTimestampOverrunMs"
      ],
      "properties": {
        "format": {
          "const": "intake-media-profile/v2"
        },
        "ffmpeg": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "libraryDirectories"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "libraryDirectories": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "whisper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "libraryDirectories"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "libraryDirectories": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "language": {
          "type": "string",
          "pattern": "^(auto|[a-z]{2,3})$"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxSourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maxAudioSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "maxTextBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "decodeTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "modelTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "maxTimestampOverrunMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    }
  }
}
