      ],
      "compiledResultSchema": {
        "$ref": "#/$defs/readRecordOrDocumentResult"
      },
      "nativeAdoptedResultSchema": {
        "$ref": "#/$defs/readRecordResult"
      },
      "viewModes": [
        "compiled",
