{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/metric-definition/v1",
  "title": "Governed metric record data",
  "description": "Metric semantics validated before proposal and commit. SQL is generated from these allowlisted fields and never supplied as an executable string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasource", "entity", "aggregation", "measure", "dimensions", "filters", "grain", "unit", "format"],
  "properties": {
    "datasource": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"const": "sqlite"}}
    },
    "entity": {"type": "string", "minLength": 1},
    "aggregation": {"enum": ["sum", "count", "avg", "min", "max"]},
    "measure": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "field"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "field": {"type": "string", "minLength": 1}}}
    },
    "filters": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "field", "operator", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "field": {"type": "string", "minLength": 1},
          "operator": {"enum": ["=", "!=", ">", ">=", "<", "<=", "in"]},
          "type": {"enum": ["string", "number", "integer", "boolean", "date"]},
          "required": {"type": "boolean"},
          "enum": {"type": "array", "uniqueItems": true, "items": {"type": ["string", "number", "integer", "boolean"]}},
          "minimum": {"type": "number"}, "maximum": {"type": "number"}
        }}
    },
    "grain": {"type": "object", "additionalProperties": false, "required": ["field", "default", "allowed"],
      "properties": {"field": {"type": "string", "minLength": 1}, "default": {"enum": ["day", "week", "month", "quarter", "year"]},
        "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["day", "week", "month", "quarter", "year"]}}}},
    "unit": {"type": "string", "minLength": 1},
    "format": {"enum": ["number", "currency", "percent", "ratio", "duration"]},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
