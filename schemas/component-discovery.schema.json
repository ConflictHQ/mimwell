{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/component-discovery/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "asOf": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "asOf"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "informationNeeds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "useCases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability": {
                "enum": [
                  "existing",
                  "local",
                  "proposed"
                ]
              },
              "reuse": {
                "type": "array",
                "items": {
                  "enum": [
                    "template",
                    "instance",
                    "external"
                  ]
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "families": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sequence": {
                "enum": [
                  "core-first",
                  "next",
                  "later"
                ]
              }
            },
            "required": [
              "availability",
              "reuse",
              "actions",
              "families",
              "sequence"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "contractsVerified": {
            "type": "boolean"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "scope",
                "path",
                "observation"
              ]
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_.\\-/]+$"
                },
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_.\\-/]+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "validator": {
                  "enum": [
                    "json-schema",
                    "brain-graph",
                    "kind-descriptors",
                    "blueprint",
                    "simulator"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "path",
                "schema",
                "validator",
                "required",
                "meaning"
              ]
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^/(?!/)[a-zA-Z0-9_./-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "querySettings": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "description",
                "href",
                "querySettings"
              ]
            }
          },
          "settingsSchema": {
            "type": "object"
          },
          "settingsMeaning": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "unreviewed",
                  "restricted",
                  "approved-internal"
                ]
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "license",
              "scope"
            ]
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "network": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "offline": {
                "enum": [
                  "local-assets",
                  "font-fallback",
                  "requires-network",
                  "unverified"
                ]
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "network",
              "offline",
              "fallback"
            ]
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "measurement": {
                "enum": [
                  "unmeasured",
                  "measured"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "model",
              "measurement",
              "notes"
            ]
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "upgrade": {
                "type": "string",
                "minLength": 1
              },
              "removal": {
                "type": "string",
                "minLength": 1
              },
              "rollback": {
                "type": "string",
                "minLength": 1
              },
              "canonicalPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "preservedUrls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "upgrade",
              "removal",
              "rollback",
              "canonicalPaths",
              "preservedUrls"
            ]
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gapIssues": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "description",
          "observedAt",
          "informationNeeds",
          "useCases",
          "labels",
          "owner",
          "component",
          "contractsVerified",
          "sourceRefs",
          "inputs",
          "outputs",
          "settingsSchema",
          "settingsMeaning",
          "rights",
          "access",
          "assets",
          "cost",
          "lifecycle",
          "limits",
          "gapIssues"
        ]
      }
    }
  },
  "required": [
    "protocolVersion",
    "sourceInventory",
    "entries"
  ]
}
