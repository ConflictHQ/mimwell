# Cloudflare Pages / Workers Assets edge headers.
# Rules are matched top to bottom; later, more specific rules win.

# Security headers on every response.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Engine assets under app/ are NOT content-hashed. Static media (images,
# fonts) is renamed when it changes, so long immutable caching is safe. Code
# (js/css) keeps plain URLs and is cache-busted by the worker's ?v=<ASSET_V>
# rewrite instead — serve it with revalidation so a token bump (or ETag
# change) takes effect immediately. Later, more specific rules win.
/app/*
  Cache-Control: public, max-age=31536000, immutable
/app/*.js
  Cache-Control: no-cache
/app/*.css
  Cache-Control: no-cache

# Data files are regenerated on each build — never cache them.
/*.json
  Cache-Control: no-cache

# HTML entry points — always revalidate so deploys take effect immediately.
/*.html
  Cache-Control: no-cache
