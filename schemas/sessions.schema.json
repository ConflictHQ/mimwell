{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/sessions/v1",
  "title": "Sessions catalog (app/sessions.json)",
  "description": "Meeting / recording catalog rendered by /intelligence/ and /app/session.html. Normally generated by scripts/gen-sessions.py.",
  "x-conflict": { "version": "1", "editable": false, "source": "app/sessions.json" },
  "type": "object",
  "required": ["sessions"],
  "properties": {
    "$comment": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "duration_min": { "type": "number", "minimum": 0 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "thumb": { "type": "string" },
          "drive_url": { "type": "string" },
          "video_url": { "type": "string" },
          "frames": { "type": "array", "items": { "type": "string" } },
          "transcript": { "type": "string" },
          "doc": { "type": "string" },
          "agenda": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": { "type": "array", "items": { "type": "string" } },
          "action_items": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
