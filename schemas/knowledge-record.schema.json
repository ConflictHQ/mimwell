{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/knowledge-record/v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "durability": {
          "type": "string",
          "enum": [
            "durable-logic",
            "point-in-time",
            "ephemeral"
          ]
        },
        "derived": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "rel",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object"
    },
    "blobs": {
      "type": "array",
      "description": "Locators of the blobs (evidence, originals) this record cites, held by the contract's `blobs` store (scripts/blob_store.py). A blob store is never an authority for a claim.",
      "items": {
        "type": "object",
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "store",
          "key",
          "sha256",
          "bytes",
          "mediaType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "collection",
    "kind",
    "content",
    "relations"
  ],
  "additionalProperties": false
}
