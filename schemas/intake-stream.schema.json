{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake-stream/v1",
  "title": "Bounded intake stream frames, results and resume cursors",
  "description": "One-frame one-page local transport. Cursors position producers and grant no authorization or completed-write claim. Runtime enforces byte, chain, progression and current planning-basis checks.",
  "allOf": [
    {
      "$ref": "#/$defs/frame"
    }
  ],
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "stream",
        "sequence",
        "previous",
        "items",
        "final"
      ],
      "properties": {
        "format": {
          "const": "intake-stream-frame/v1"
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "conflict:schema/intake/v1#/$defs/item"
          }
        },
        "final": {
          "type": "boolean"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "stream",
        "sequence",
        "previous",
        "frameSha256",
        "offset",
        "inputSha256",
        "planningSha256"
      ],
      "properties": {
        "format": {
          "const": "intake-stream-cursor/v1"
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frameSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "inputSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "planningSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "stream",
        "sequence",
        "frameSha256",
        "page",
        "cursor"
      ],
      "properties": {
        "format": {
          "const": "intake-stream-result/v1"
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frameSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "oneOf": [
            {
              "$ref": "conflict:schema/intake/v1#/$defs/result"
            },
            {
              "$ref": "conflict:schema/classified-intake/v1#/$defs/result"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "stream",
        "reason",
        "cursor"
      ],
      "properties": {
        "format": {
          "const": "intake-stream-stop/v1"
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "reason": {
          "enum": [
            "maxFrames",
            "maxPages",
            "no-progress"
          ]
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      }
    }
  }
}
