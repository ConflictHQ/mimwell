{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake/v1",
  "title": "Bounded deterministic intake planning and immutable correction history",
  "description": "Proposals only. Imported descriptors and history are not authorization or authenticated authorship. Runtime enforces mappings, chain hashes, offsets and current source/destination policy.",
  "allOf": [
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "sha256",
            "mediaType",
            "byteLength",
            "reference"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "backend",
                "object",
                "locator",
                "availability"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "object": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "locator": {
                  "type": "string"
                },
                "availability": {
                  "enum": [
                    "available",
                    "unavailable",
                    "unknown"
                  ]
                }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant",
        "authority",
        "collection",
        "revision"
      ],
      "properties": {
        "participant": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "labels",
        "destinations",
        "processing"
      ],
      "properties": {
        "action": {
          "enum": [
            "keep",
            "skip",
            "review"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "processing": {
          "enum": [
            "none",
            "metadata",
            "extract"
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "taxonomy",
        "rules",
        "destinations"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "ontologySha256",
            "labels"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "ontologySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kinds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "kinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "conditions",
              "intent",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "operator",
                    "value"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "operator": {
                      "enum": [
                        "equals",
                        "prefix",
                        "atMost"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ]
                    }
                  }
                },
                "minItems": 1
              },
              "intent": {
                "$ref": "#/$defs/intent"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "target",
              "resource",
              "mode",
              "kinds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "target": {
                "$ref": "#/$defs/target"
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "mode": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxItems",
        "maxInputBytes",
        "maxOutputBytes"
      ],
      "properties": {
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "items",
        "offset",
        "inputSha256",
        "budget"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "inputSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "taxonomySha256",
        "ontologySha256",
        "policySha256"
      ],
      "properties": {
        "configurationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "taxonomySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ontologySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "labels",
        "kinds",
        "processing",
        "destinations",
        "gaps",
        "confidence",
        "requiresReview"
      ],
      "properties": {
        "action": {
          "enum": [
            "keep",
            "skip",
            "review"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "processing": {
          "enum": [
            "none",
            "metadata",
            "extract"
          ]
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "target",
              "status",
              "completionSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "target": {
                "$ref": "#/$defs/target"
              },
              "status": {
                "enum": [
                  "proposed",
                  "already-ingested",
                  "read-only",
                  "kind-mismatch",
                  "proposal-denied"
                ]
              },
              "completionSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "null"
        },
        "requiresReview": {
          "const": true
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "previous",
        "type",
        "actor",
        "at",
        "decision",
        "reason",
        "mechanism"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "proposal",
            "correction"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "rule"
          ],
          "properties": {
            "tier": {
              "enum": [
                "rules",
                "unassisted",
                "correction"
              ]
            },
            "rule": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "item",
        "basis",
        "events"
      ],
      "properties": {
        "format": {
          "const": "intake-history/v1"
        },
        "item": {
          "$ref": "#/$defs/item"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1
        }
      }
    },
    "row": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "status"
          ],
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "status",
            "history"
          ],
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "planned"
            },
            "history": {
              "$ref": "#/$defs/history"
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "inputSha256",
        "authorization",
        "basis",
        "limits",
        "offset",
        "nextOffset",
        "results",
        "truncation",
        "usage"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal",
            "evaluatedAt"
          ],
          "properties": {
            "principal": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evaluatedAt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "truncation": {
          "type": "array",
          "items": {
            "enum": [
              "maxItems",
              "maxBytes"
            ]
          },
          "uniqueItems": true
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelCalls",
            "inputTokens",
            "outputTokens",
            "elapsedMicros"
          ],
          "properties": {
            "modelCalls": {
              "const": 0
            },
            "inputTokens": {
              "const": 0
            },
            "outputTokens": {
              "const": 0
            },
            "elapsedMicros": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
