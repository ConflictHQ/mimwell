        },
        "reservationStates": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unavailableReasons": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "aggregateCapacity": {
