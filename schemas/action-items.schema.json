{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/action-items/v1",
  "title": "Action items rollup (app/action-items.json)",
  "description": "Cross-session action-item rollup rendered by /action-items/.",
  "x-conflict": { "version": "1", "editable": true, "source": "app/action-items.json" },
  "type": "object",
  "required": ["items"],
  "properties": {
    "$comment": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "date": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "session": { "type": "string" },
          "session_title": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
