{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/deliverables/v1",
  "title": "Deliverables (app/deliverables.json)",
  "description": "Engagement deliverables rendered by /deliverables/. status: delivered | in-progress | planned.",
  "x-conflict": {
    "version": "1",
    "editable": true,
    "source": "app/deliverables.json"
  },
  "type": "object",
  "required": [
    "deliverables"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "delivered",
              "in-progress",
              "planned"
            ]
          },
          "phase": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "link": {
            "type": "string"
          },
          "linkLabel": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "version": {
      "type": "integer"
    },
    "changelog": {
      "type": "array",
      "description": "Bump version/updated and append an entry here on every hand edit (the fill-in contract in bootstrap.md).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
