{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proposals.schema.json",
  "title": "Organizer proposals",
  "description": "Unaccepted organizer claims awaiting curation. Producer metadata and extraction confidence do not authorize promotion. Intake validates complete payloads and rejects conflicting identities; accepted equivalences and dismissals remain curator-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "proposals"
  ],
  "properties": {
    "format": {
      "const": "proposals/v1"
    },
    "generator": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "rel",
          "source",
          "target",
          "confidence",
          "evidence",
          "proposed_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "equivalence"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "rel": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "proposed_by": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Producer-claimed metadata; not an authorization grant."
    },
    "realm": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Producer-claimed metadata; not an authorization grant."
    }
  }
}
