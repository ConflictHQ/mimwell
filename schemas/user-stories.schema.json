{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/user-stories/v1",
  "title": "User stories (app/user-stories.json)",
  "description": "User stories rendered by /user-stories/. status: draft | ready | in-progress | done.",
  "x-conflict": {
    "version": "1",
    "editable": true,
    "source": "app/user-stories.json"
  },
  "type": "object",
  "required": [
    "stories"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "$exampleStory": {
      "$ref": "#/$defs/story"
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "version": {
      "type": "integer"
    },
    "updated": {
      "type": "string"
    },
    "changelog": {
      "type": "array",
      "description": "Bump version/updated and append an entry here on every hand edit (the fill-in contract in bootstrap.md).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "story": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "as_a": {
          "type": "string"
        },
        "i_want": {
          "type": "string"
        },
        "so_that": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "ready",
            "in-progress",
            "done"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "epic": {
          "type": "string"
        },
        "deliverable": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
