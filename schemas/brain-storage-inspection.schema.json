          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "accounting"
            ]
          },
          {
            "required": [
              "reservationStates"
            ]
          }
        ]
      }
    },
