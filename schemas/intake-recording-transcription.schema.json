{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/intake-recording-transcription/v1",
  "title": "Accounted parent-linked recording range transcription",
  "description": "Execution provenance is immutable; current release authorization can be refreshed. Each range is a distinct intake reference, never completion of the whole original.",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/profile"
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "whisper",
        "model",
        "language",
        "threads",
        "maxTextBytes",
        "maxSegments",
        "modelTimeoutSeconds",
        "maxTimestampOverrunMs"
      ],
      "properties": {
        "format": {
          "const": "intake-recording-transcriber/v1"
        },
        "whisper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "libraryDirectories"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "libraryDirectories": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "language": {
          "type": "string",
          "pattern": "^(auto|[a-z]{2,3})$"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxTextBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "modelTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "maxTimestampOverrunMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "item",
        "profile",
        "profileSha256",
        "dependencies",
        "principal",
        "evaluatedAt",
        "scopes",
        "policySha256",
        "bindingsSha256",
        "language",
        "coverage",
        "requiresReview",
        "segments",
        "gaps",
        "usage",
        "timingSemantics",
        "sourceChunk",
        "protection",
        "execution",
        "inferenceSha256"
      ],
      "properties": {
        "format": {
          "const": "intake-recording-transcription/v1"
        },
        "item": {
          "$ref": "conflict:schema/intake/v1#/$defs/item"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "profileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceResource",
            "modelResource",
            "scope",
            "modelIdentity"
          ],
          "properties": {
            "sourceResource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "modelResource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "modelIdentity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "coverage": {
          "const": "selected-recording-range-transcript"
        },
        "requiresReview": {
          "const": true
        },
        "segments": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reportedLocator",
              "sourceWindow",
              "timingStatus",
              "text",
              "parentWindow"
            ],
            "properties": {
              "reportedLocator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "properties": {
                  "kind": {
                    "const": "audio-ms"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 630000
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 630000
                  }
                }
              },
              "sourceWindow": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "properties": {
                  "kind": {
                    "const": "audio-frames"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9600000
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9600000
                  }
                }
              },
              "timingStatus": {
                "enum": [
                  "within-audio-estimate",
                  "extends-past-audio"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 1048576
              },
              "parentWindow": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "properties": {
                  "kind": {
                    "const": "audio-frames"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 345600000
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 345600000
                  }
                }
              }
            }
          }
        },
        "gaps": {
          "enum": [
            [],
            [
              "no-transcript"
            ]
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceBytes",
            "normalizedBytes",
            "textBytes",
            "modelExecutions",
            "processCalls"
          ],
          "properties": {
            "sourceBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "normalizedBytes": {
              "type": "integer",
              "minimum": 46,
              "maximum": 19200044
            },
            "textBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "modelExecutions": {
              "const": 1
            },
            "processCalls": {
              "const": 1
            }
          }
        },
        "timingSemantics": {
          "const": "chunk-estimate-with-parent-window-not-alignment"
        },
        "sourceChunk": {
          "$ref": "conflict:schema/intake-recording/v1#/$defs/chunk"
        },
        "protection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policySha256",
            "requirements"
          ],
          "properties": {
            "policySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encryption",
                "mediation",
                "opaqueMetadata",
                "offline",
                "plaintextCopies",
                "derivatives",
                "verifiedAuthorship"
              ],
              "properties": {
                "encryption": {
                  "type": "boolean"
                },
                "mediation": {
                  "type": "boolean"
                },
                "opaqueMetadata": {
                  "type": "boolean"
                },
                "offline": {
                  "type": "boolean"
                },
                "plaintextCopies": {
                  "type": "boolean"
                },
                "derivatives": {
                  "type": "boolean"
                },
                "verifiedAuthorship": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "principal",
            "startedAt",
            "policySha256",
            "bindingsSha256",
            "sourceChunkSha256",
            "profileSha256",
            "usage"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "principal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "policySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bindingsSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceChunkSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "profileSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "modelExecutions",
                "processCalls",
                "elapsedMs"
              ],
              "properties": {
                "modelExecutions": {
                  "const": 1
                },
                "processCalls": {
                  "const": 1
                },
                "elapsedMs": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "inferenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
