{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/record-views/v1",
  "description": "Presentation of an already authorized flat record collection; view scope is not access policy. Keys are explicit source-local identities and must be unique.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^/(?!/)[a-zA-Z0-9_/-]+/$",
            "maxLength": 300
          },
          "entry": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "pinned": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,79}$"
            },
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,79}$"
                },
                "key": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                  },
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true
                },
                "scope": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                      },
                      "op": {
                        "enum": [
                          "eq",
                          "contains",
                          "in",
                          "exists"
                        ]
                      },
                      "value": {
                        "oneOf": [
                          {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ],
                            "maxLength": 300,
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                              ],
                              "maxLength": 300,
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "minItems": 1,
                            "maxItems": 32
                          }
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "op",
                      "value"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 16
                },
                "facets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "required": [
                      "field",
                      "label"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 8
                },
                "groupBy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "order": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                      },
                      "direction": {
                        "enum": [
                          "asc",
                          "desc"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "direction"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 4
                },
                "search": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
                  },
                  "minItems": 0,
                  "maxItems": 12,
                  "uniqueItems": true
                },
                "layout": {
                  "enum": [
                    "list",
                    "detail",
                    "workbench"
                  ]
                },
                "density": {
                  "enum": [
                    "comfortable",
                    "compact"
                  ]
                },
                "responsive": {
                  "enum": [
                    "auto",
                    "stacked"
                  ]
                },
                "pageSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "breadcrumbs": {
                  "type": "boolean"
                },
                "defaultSelection": {
                  "enum": [
                    "none",
                    "first"
                  ]
                },
                "artifact": {
                  "type": "string",
                  "pattern": "^app/[A-Za-z0-9_-]+\\.json$",
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "label",
                "kind",
                "key",
                "scope",
                "facets",
                "groupBy",
                "order",
                "search",
                "layout",
                "density",
                "responsive",
                "pageSize",
                "breadcrumbs",
                "defaultSelection",
                "artifact"
              ]
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "url",
          "entry",
          "pinned",
          "views"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "protocolVersion",
    "pages"
  ]
}
