{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/stakeholders/v1",
  "title": "Stakeholders (app/stakeholders.json)",
  "description": "Stakeholders / team directory rendered by /stakeholders/.",
  "x-conflict": {
    "version": "1",
    "editable": true,
    "source": "app/stakeholders.json"
  },
  "type": "object",
  "required": [
    "people"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "integer"
    },
    "updated": {
      "type": "string"
    },
    "changelog": {
      "type": "array",
      "description": "Bump version/updated and append an entry here on every hand edit (the fill-in contract in bootstrap.md).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
