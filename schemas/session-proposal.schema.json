{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/session-proposal/v1",
  "type": "object",
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "time",
        "source"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rel": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rel",
                "target"
              ],
              "additionalProperties": false
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "session",
    "records"
  ],
  "additionalProperties": false
}
