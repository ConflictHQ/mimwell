{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/semantic-authoring-tasks/v1",
  "type": "object",
  "required": [
    "format",
    "tasks",
    "fieldHints"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "semantic-authoring-tasks/v1"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "success",
          "failure",
          "example",
          "counterexample",
          "toolTemplate",
          "prompt",
          "inputs",
          "outputs",
          "references",
          "capabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "counterexample": {
            "type": "string",
            "minLength": 1
          },
          "toolTemplate": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                }
              }
            }
          }
        }
      }
    },
    "fieldHints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "purpose",
          "example",
          "counterexample",
          "unknown",
          "pointer",
          "schemaSha256"
        ],
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "counterexample": {
            "type": "string",
            "minLength": 1
          },
          "unknown": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "schemaSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
