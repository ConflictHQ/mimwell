{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sources",
    "representations",
    "assertions",
    "attestations"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/evidence/v1",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "currentRevision",
        "lineage",
        "path",
        "sha256",
        "modality",
        "capturedAt",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "currentRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "lineage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "modality": {
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "code",
            "document",
            "structured"
          ]
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "derivedFrom",
        "path",
        "sha256",
        "modality",
        "extractedAt",
        "extractor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "modality": {
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "code",
            "document",
            "structured"
          ]
        },
        "extractedAt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "extractor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "field",
        "value",
        "status",
        "contradicts",
        "supersedes",
        "retracts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node"
              ],
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edge"
              ],
              "properties": {
                "edge": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "target",
                    "rel"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "rel": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          ]
        },
        "field": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "value": {},
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "retracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assertion",
        "representation",
        "locator",
        "stance",
        "asserter",
        "basis",
        "assertedAt",
        "validity",
        "confidence",
        "authority",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "assertion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "start",
                "end",
                "quote"
              ],
              "properties": {
                "kind": {
                  "const": "text"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "startLine",
                "endLine",
                "commit"
              ],
              "properties": {
                "kind": {
                  "const": "code"
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "commit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "page",
                "region"
              ],
              "properties": {
                "kind": {
                  "const": "page"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "region": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "width": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "height": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "region"
              ],
              "properties": {
                "kind": {
                  "const": "image"
                },
                "region": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "startMs",
                "endMs"
              ],
              "properties": {
                "kind": {
                  "const": "time"
                },
                "startMs": {
                  "type": "number",
                  "minimum": 0
                },
                "endMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "mentions"
          ]
        },
        "asserter": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "basis": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        },
        "assertedAt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "until"
          ],
          "properties": {
            "from": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "until": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "authority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "by",
            "at",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "unreviewed",
                "reviewed",
                "disputed",
                "retracted"
              ]
            },
            "by": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "at": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation",
        "status",
        "reasons",
        "href",
        "locatorVerification",
        "lineages"
      ],
      "properties": {
        "attestation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "available",
            "stale",
            "missing",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locatorVerification": {
          "enum": [
            "exact-text",
            "line-range",
            "anchor-only",
            "unavailable"
          ]
        },
        "lineages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "matchesRecord",
        "supportingLineages",
        "contradictingLineages"
      ],
      "properties": {
        "assertion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "matchesRecord": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supportingLineages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "contradictingLineages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sources",
        "representations",
        "assertions",
        "attestations",
        "unresolvedAssertions",
        "observations",
        "claims"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/representation"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attestation"
          }
        },
        "unresolvedAssertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    }
  }
}
