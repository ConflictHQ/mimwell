            "maximum": 50,
            "default": 10
          }
        }
      },
      "nativeInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Keywords, e.g. 'pricing decision' or 'churn'."
          },
          "kind": {
            "type": "string",
            "maxLength": 64,
            "description": "Only records of this kind (e.g. 'Decision', 'Term', 'Metric'), or 'document' for documents only."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        }
      },
      "resultVariants": [
        "record-and-document-matches",
        "record-only-native-matches"
      ],
      "compiledResultSchema": {
        "$ref": "#/$defs/searchResult"
      },
      "nativeAdoptedResultSchema": {
        "$ref": "#/$defs/nativeSearchResult"
      },
      "viewModes": [
        "compiled",
