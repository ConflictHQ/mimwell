      ]
    },
    "list_definitions": {
      "legacyInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Only definitions whose name, alias or text contains this."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50,
            "description": "At most this many terms, and as many metrics."
          }
        }
      },
      "nativeInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Only definitions whose name, alias or text contains this."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50,
            "description": "At most this many terms, and as many metrics."
          }
        }
      },
      "resultVariants": [
        "terms-metrics-schema-kinds-counts"
      ],
      "compiledResultSchema": {
        "$ref": "#/$defs/definitionsResult"
      },
      "nativeAdoptedResultSchema": {
        "$ref": "#/$defs/definitionsResult"
      },
      "viewModes": [
        "compiled",
        "native-adopted"
      ]
    },
    "resolve_metric": {
      "legacyInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "A metric's name, alias or id, e.g. 'monthly recurring revenue'."
          }
        }
      },
      "nativeInputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "A metric's name, alias or id, e.g. 'monthly recurring revenue'."
          }
        }
      },
      "resultVariants": [
        "single-metric",
        "ambiguous-candidates"
      ],
      "compiledResultSchema": {
        "$ref": "#/$defs/resolveMetricResult"
      },
      "nativeAdoptedResultSchema": {
        "$ref": "#/$defs/resolveMetricResult"
      },
      "viewModes": [
        "compiled",
        "native-adopted"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "search_records"
          },
          "authorityView": {
            "const": "compiled"
          }
        },
        "required": [
          "tool",
          "authorityView"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/searchResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "search_records"
          },
          "authorityView": {
            "const": "native-adopted"
          }
        },
        "required": [
          "tool",
          "authorityView"
        ]
