{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conflict:schema/knowledge-operation/v6",
  "title": "Selected file and multi-destination operations with exact receipts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "authority",
    "operation",
    "contract",
    "authorization",
    "state",
    "native",
    "nativeSha256",
    "nativeWire",
    "requestWire",
    "requestSha256"
  ],
  "properties": {
    "format": {
      "const": "knowledge-operation/v6"
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "operation": {
      "enum": [
        "intake.history-propose",
        "intake.delivery-propose",
        "intake.processed-delivery-propose",
        "intake.source-review",
        "intake.source-revoke",
        "intake.completion-plan",
        "intake.completion-refresh",
        "file.inspect",
        "file.history",
        "file.propose",
        "file.proposal-inspect",
        "file.review",
        "file.publish",
        "file.propose-binary",
        "file.group.inspect",
        "file.group.propose",
        "file.group.propose-binary",
        "file.group.proposal-inspect",
        "file.group.review",
        "file.group.destination-publish",
        "file.group.status"
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "evaluatedAt",
        "revalidatedAt"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revalidatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "state": {
      "const": "completed"
    },
    "native": {},
    "nativeSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nativeWire": {
      "type": "string",
      "description": "Exact UTF-8 canonical native result; SHA-256 equals nativeSha256 without numeric reserialization."
    },
    "requestWire": {
      "type": "string"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
